#!/usr/bin/make -f

# Before the tests run, two things are put into the build directory.
# The package metadata: tests/test_version.py reads the version from it, and pybuild creates it on
# its own only at the install stage, which comes after the tests. pybuild deletes it from the build
# directory itself before installing.
# The shipped config and form schema: the tests check them, and they live in the source root, not
# in the Python package. They are removed again after the tests, otherwise they would be installed
# next to the Python modules.
export PYBUILD_BEFORE_TEST=cd {dir} && {interpreter} setup.py --quiet egg_info --egg-base {build_dir} && cp wb-mqtt-dmx.conf wb-mqtt-dmx.schema.json {build_dir}
export PYBUILD_AFTER_TEST=rm -f {build_dir}/wb-mqtt-dmx.conf {build_dir}/wb-mqtt-dmx.schema.json

%:
	dh $@ --with python3 --buildsystem=pybuild
